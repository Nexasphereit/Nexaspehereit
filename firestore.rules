rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions (kept for backward compatibility, returns true)
    function isSignedIn() {
      return true;
    }
    function isOwner(userId) {
      return true;
    }
    function isMasterAdmin() {
      return true;
    }

    // 1. Catalog collections - Relaxed for sandbox development
    match /nexasphereit_services/{id} {
      allow read, write: if true;
    }
    match /nexasphereit_portfolio/{id} {
      allow read, write: if true;
    }
    match /nexasphereit_pricing_plans/{id} {
      allow read, write: if true;
    }
    match /nexasphereit_blog/{id} {
      allow read, write: if true;
    }
    match /nexasphereit_team/{id} {
      allow read, write: if true;
    }
    match /nexasphereit_milestones/{id} {
      allow read, write: if true;
    }
    match /nexasphereit_faqs/{id} {
      allow read, write: if true;
    }
    match /nexasphereit_reviews/{id} {
      allow read, write: if true;
    }
    match /nexasphereit_portal_updates/{id} {
      allow read, write: if true;
    }
    match /services/{id} {
      allow read, write: if true;
    }

    // 2. configurations
    match /nexasphereit_config/{id} {
      allow read, write: if true;
    }

    // 3. Public landing forms & user submissions
    match /nexasphereit_leads/{id} {
      allow read, write: if true;
    }
    match /nexasphereit_messages/{id} {
      allow read, write: if true;
    }

    // 4. CRM Client & transactional logs
    match /customers/{id} {
      allow read, write: if true;
    }
    match /transactions/{id} {
      allow read, write: if true;
    }
    match /sms_logs/{id} {
      allow read, write: if true;
    }
    match /nexasphereit_ads/{id} {
      allow read, write: if true;
    }

    // 5. Generator document listings (Quotations, CVs, Receipts, Menus)
    match /quotations/{id} {
      allow read, write: if true;
    }
    match /cvs/{id} {
      allow read, write: if true;
    }
    match /receipts/{id} {
      allow read, write: if true;
    }
    match /menus/{id} {
      allow read, write: if true;
    }

    // 6. Users collection - Users can read and write metadata
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}

