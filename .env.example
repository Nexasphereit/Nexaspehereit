# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# PRODUCTION HOSTING CONFIGURATIONS
# =========================================================================
# Configure these variables on your main server (Node.js backend) or 
# environmental hosting variables to enable seamless direct database storage.

# Backend Firebase Variables:
FIREBASE_API_KEY="AIzaSy..."
FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="1234567890"
FIREBASE_APP_ID="1:1234:web:abcd"
FIREBASE_DATABASE_ID="your-firestore-database-id"

# Frontend Client-side Variables (Vite prefixed):
# Enable these on your client build systems so the frontend can target them.
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234:web:abcd"
VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"

